# Local demo (default): SQLite — no Postgres required to try the MVP
DATABASE_URL=sqlite:///./builderone.db

# Production / real Postgres — uncomment and fill in (never commit real secrets):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/builderone

JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_PATH=./uploads
SEED_ON_STARTUP=true
